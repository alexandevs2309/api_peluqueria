{
  "$schema": "../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/auth/**"
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/assets/favicon/site.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "branches-and-config",
      "urls": [
        "*/api/settings/branches/**",
        "*/api/settings/barbershop/**"
      ],
      "cacheConfig": {
        "maxSize": 10,
        "maxAge": "1h",
        "timeout": "5s",
        "strategy": "freshness"
      }
    },
    {
      "name": "appointments-api",
      "urls": [
        "*/api/appointments/appointments/**"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "30m",
        "timeout": "5s",
        "strategy": "performance"
      }
    },
    {
      "name": "employees-api",
      "urls": [
        "*/api/employees/employees/**"
      ],
      "cacheConfig": {
        "maxSize": 30,
        "maxAge": "30m",
        "timeout": "5s",
        "strategy": "performance"
      }
    },
    {
      "name": "services-api",
      "urls": [
        "*/api/services/services/**",
        "*/api/services/categories/**"
      ],
      "cacheConfig": {
        "maxSize": 30,
        "maxAge": "1h",
        "timeout": "5s",
        "strategy": "performance"
      }
    },
    {
      "name": "products-api",
      "urls": [
        "*/api/inventory/products/**",
        "*/api/inventory/categories/**"
      ],
      "cacheConfig": {
        "maxSize": 30,
        "maxAge": "1h",
        "timeout": "5s",
        "strategy": "performance"
      }
    },
    {
      "name": "clients-api",
      "urls": [
        "*/api/clients/clients/**"
      ],
      "cacheConfig": {
        "maxSize": 30,
        "maxAge": "30m",
        "timeout": "5s",
        "strategy": "performance"
      }
    },
    {
      "name": "pos-sales-api",
      "urls": [
        "*/api/pos/sales/**",
        "*/api/pos/coupons/**",
        "*/api/pos/promotions/**"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "10m",
        "timeout": "5s",
        "strategy": "freshness"
      }
    },
    {
      "name": "pos-categories-api",
      "urls": [
        "*/api/pos/categories/**",
        "*/api/pos/config/**"
      ],
      "cacheConfig": {
        "maxSize": 10,
        "maxAge": "1h",
        "timeout": "5s",
        "strategy": "performance"
      }
    },
    {
      "name": "reports-api",
      "urls": [
        "*/api/reports/**"
      ],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "15m",
        "timeout": "5s",
        "strategy": "freshness"
      }
    },
    {
      "name": "payroll-api",
      "urls": [
        "*/api/employees/payroll/**",
        "*/api/employees/earnings/**",
        "*/api/employees/attendance/**"
      ],
      "cacheConfig": {
        "maxSize": 30,
        "maxAge": "30m",
        "timeout": "5s",
        "strategy": "performance"
      }
    }
  ]
}
