{
  "name": "auron-suite-web",
  "version": "20.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:dev": "ng serve --configuration development --live-reload=false",
    "start:watch": "CHOKIDAR_USEPOLLING=false ng serve --configuration development --watch",
    "start:prod": "ng serve --configuration production",
    "build": "ng build --configuration production",
    "prebuild": "node scripts/generate-changelog.js",
    "build:dev": "ng build --configuration development",
    "build:prod": "ng build --configuration=production",
    "build:profile": "ng build --configuration profile",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write \"**/*.{js,mjs,ts,mts,d.ts,html}\" --cache",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:perf": "npx lhci autorun",
    "perf:budget": "npx lhci collect --config=lighthouserc.json",
    "deploy:marketing": "npm run build && node scripts/prepare-marketing.mjs && npx wrangler deploy --config wrangler.marketing.jsonc",
    "deploy:app": "npm run build && npx wrangler deploy --config wrangler.jsonc"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.25",
    "@angular/common": "20.3.25",
    "@angular/compiler": "20.3.25",
    "@angular/core": "20.3.25",
    "@angular/forms": "20.3.25",
    "@angular/platform-browser": "20.3.25",
    "@angular/platform-browser-dynamic": "20.3.25",
    "@angular/router": "20.3.25",
    "@angular/service-worker": "20.3.25",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@primeuix/themes": "^1.2.5",
    "@stripe/stripe-js": "^9.4.0",
    "@tailwindcss/postcss": "^4.1.15",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "aos": "^2.3.4",
    "chart.js": "^4.5.1",
    "gsap": "^3.13.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.2",
    "logrocket": "^12.1.1",
    "primeicons": "^7.0.0",
    "primeng": "^20.2.0",
    "rxjs": "~7.8.2",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.25",
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular-eslint/utils": "^20.7.0",
    "@angular/build": "^20.3.25",
    "@angular/cli": "20.3.25",
    "@angular/compiler-cli": "20.3.25",
    "@playwright/test": "^1.60.0",
    "@types/jasmine": "^5.1.12",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.4",
    "jasmine-core": "^5.12.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  }
}