{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Proyecto separado para el sitio de marketing (landing, pricing, términos, etc.)
  // Deploy: npx wrangler deploy --config wrangler.marketing.jsonc
  // Build previo: npm run build
  "name": "auron-marketing",
  "compatibility_date": "2026-04-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/auron-suite/browser",
    // SPA handling para que Angular Router maneje /landing, /terms, /privacy, etc.
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
