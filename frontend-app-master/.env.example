# =============================================================================
# AURON SUITE — Frontend variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees .env ni ningún archivo con credenciales reales.
# =============================================================================

# URL base de la API de Django (obligatorio)
# Desarrollo: http://localhost:8000/api
# Staging:    https://api-staging.tudominio.com/api
# Producción: https://api.tudominio.com/api
API_URL=http://localhost:8000/api

# URL del WebSocket (opcional, fallback a ws:// de API_URL)
# WS_URL=ws://localhost:8000/ws

# Stripe publishable key (entorno sandbox vs live)
# Obtener en: https://dashboard.stripe.com/test/apikeys (test)
# O en:       https://dashboard.stripe.com/apikeys (live)
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# =============================================================================
# Build configuration (usado por angular.json > configurations)
# =============================================================================
# production:     ng build --configuration production
# staging:        ng build --configuration staging
# development:    ng serve (default)

# =============================================================================
# Debug / Feature flags (development only)
# =============================================================================
# DEBUG_CONSOLE=1        # Re-activa console.log/info/debug/trace en dev
# ENABLE_MOCK_DATA=true  # Usa datos mock en lugar de API real
