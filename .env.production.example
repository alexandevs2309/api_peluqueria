# =============================================================================
# AURON SUITE — PLANTILLA OFICIAL DE VARIABLES DE ENTORNO PARA PRODUCCIÓN
# =============================================================================
# Copia este archivo como '.env' en tu servidor de producción final (VPS / Cloud).
# =============================================================================

# 1. DJANGO PRODUCTION CORE
DEBUG=False
# Genera una clave criptográfica aleatoria de 64+ caracteres con: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA_DE_64_CARACTERES_PRODUCCION_2026
JWT_SIGNING_KEY=REEMPLAZAR_CON_OTRA_CLAVE_ALEATORIA_DISTINTA_JWT_2026

# Dominios permitidos (sin https://)
ALLOWED_HOSTS=api.tudominio.com,tudominio.com,www.tudominio.com,*.tudominio.com

# 2. BASE DE DATOS POSTGRESQL (Servidor de Producción / RDS / Supabase / VPS)
DB_NAME=barbershop_prod_db
DB_USER=barbershop_prod_user
DB_PASSWORD=ContrasenaSuperSeguraDeBaseDeDatos2026!
DB_HOST=db
DB_PORT=5432
PGBOUNCER_ENABLED=true

# 3. REDIS & CELERY (Broker en Producción)
REDIS_PASSWORD=RedisPasswordSegura2026!
REDIS_URL=redis://:RedisPasswordSegura2026!@redis:6379/0
CELERY_BROKER_URL=redis://:RedisPasswordSegura2026!@redis:6379/0
CELERY_RESULT_BACKEND=redis://:RedisPasswordSegura2026!@redis:6379/0

# 4. CORS & CSRF (Restringido estrictamente a tu frontend de producción)
FRONTEND_URL=https://app.tudominio.com
CORS_ALLOWED_ORIGINS=https://app.tudominio.com,https://tudominio.com,https://www.tudominio.com
CSRF_TRUSTED_ORIGINS=https://app.tudominio.com,https://tudominio.com,https://www.tudominio.com,https://api.tudominio.com

# 5. CONFIGURACIÓN REGIONAL & MONEDA
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=es-DO
TIME_ZONE=America/Santo_Domingo

# 6. CORREOS TRANSACCIONALES (Opción A: Resend / Opción B: SendGrid / Opción C: SMTP Google Workspace)
# --- Opción A: Resend (Recomendado) ---
# RESEND_API_KEY=re_123456789abcdef...

# --- Opción B: SendGrid ---
# SENDGRID_API_KEY=SG.123456789abcdef...

# --- Opción C: SMTP Estándar (Google Workspace / Zoho / Amazon SES) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notificaciones@tudominio.com
EMAIL_HOST_PASSWORD=contrasena_de_aplicacion_16_caracteres
DEFAULT_FROM_EMAIL=Auron Suite <notificaciones@tudominio.com>

# 7. PASARELA DE PAGO (Stripe Modo Live / Producción)
STRIPE_SECRET_KEY=sk_live_51...
STRIPE_PUBLISHABLE_KEY=pk_live_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_LIVE_MODE_CONFIRMED=True

# 8. SOPORTE Y CONTACTO
SUPPORT_EMAIL=soporte@tudominio.com
SUPPORT_URL=https://tudominio.com/soporte

# 9. LLM / ASISTENTE IA (Gemini recomendado: https://aistudio.google.com -> Get API key)
# Auto-detección: si GEMINI_API_KEY está definida se usa Gemini; fallback a DEEPSEEK u OPENAI.
LLM_PROVIDER=          # gemini | deepseek | openai | en blanco = auto
GEMINI_API_KEY=        # Tu clave de Gemini (empieza con AIza... o AQ.)
GEMINI_MODEL=gemini-3.5-flash
# Alternativa barata: DeepSeek (https://platform.deepseek.com)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# Alternativa: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Para proveedores OpenAI-compatible alternativos (Groq, OpenRouter, Mistral, etc.)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...

